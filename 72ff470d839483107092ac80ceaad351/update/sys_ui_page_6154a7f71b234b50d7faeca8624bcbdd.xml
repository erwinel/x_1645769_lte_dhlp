<?xml version="1.0" encoding="UTF-8"?><record_update table="sys_ui_page">
    <sys_ui_page action="INSERT_OR_UPDATE">
        <category>general</category>
        <client_script><![CDATA[function actionOK() {
    var ga = new GlideAjax('x_1645769_lte_dhlp.FlowMarkdownGenerator');
    ga.addParam('sysparm_name', 'attachMarkdown');
    ga.addParam('sysparm_sys_id', $('sys_hub_flow').value);
    ga.addParam('sysparm_folder', $('folder').value);
    ga.getXMLAnswer(function(answer) {
		try {
			var result = JSON.parse(answer);
			if (result.success) {
				$('response_message').textContent = "Success: Downloading " + result.file_name;
				var downloadUrl = '/sys_attachment.do?sys_id=' + result.sys_id;
				if (typeof g_navigation !== 'undefined')
					g_navigation.open(downloadUrl, '_blank');
				else
					window.open(downloadUrl, '_blank');
			} else
				$('response_message').textContent = result.message;
		} catch (e) {
			$('response_message').textContent = 'Failed to parse response: ' + e + '\n\nActual resonpse:\n' + JSON.stringify(answer);
		}
    });
}]]></client_script>
